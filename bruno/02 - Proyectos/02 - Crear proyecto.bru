meta {
  name: Crear proyecto
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/projects
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": "Monitoreo del agua",
    "description": "Herramienta para una comunidad.",
    "category_id": {{categoryId}},
    "status": "open"
  }
}

script:pre-request {
  bru.setVar('projectId', '0');
}

script:post-response {
  if (res.status === 201 && res.body.project && res.body.project.id) {
    bru.setVar('projectId', String(res.body.project.id));
  }
}
