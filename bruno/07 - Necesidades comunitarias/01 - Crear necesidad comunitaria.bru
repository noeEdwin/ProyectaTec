meta {
  name: Crear necesidad comunitaria
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/community-needs
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": "Capacitación en gestión de agua",
    "description": "La comunidad requiere acompañamiento técnico.",
    "category_id": {{categoryId}},
    "location": "Oaxaca",
    "status": "open"
  }
}

script:pre-request {
  bru.setVar('communityNeedId', '0');
}

script:post-response {
  if (res.status === 201 && res.body.community_need && res.body.community_need.id) {
    bru.setVar('communityNeedId', String(res.body.community_need.id));
  }
}
