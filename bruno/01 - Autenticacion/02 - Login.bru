meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "test@example.com",
    "password": "password"
  }
}

script:post-response {
  if (res.status === 200 && res.body.access_token) {
    bru.setVar('token', res.body.access_token);
  }
}
